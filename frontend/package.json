{
  "name": "ferry-frontend",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development --minify false",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import ./tests/resolve-ts.mjs --test \"tests/**/*.test.mjs\"",
    "test:smoke": "node tests/smoke/plain-browser.mjs && node tests/smoke/desktop-startup.mjs && node tests/smoke/desktop-flows.mjs && node tests/smoke/flows-rules.mjs && node tests/smoke/flows-inspect.mjs && node tests/smoke/flows-subs.mjs && node tests/smoke/flows-system.mjs",
    "test:e2e": "node tests/e2e/real-app.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
