{
  "description": "Ferry 懒人分流配置预设：自定义社区 SRS 规则集 + 应用分组 + 黄金顺序分流规则 + 防泄露分流 DNS。可在 Ferry 规则页点击「懒人预设」一键应用。",
  "ruleSets": [
    {
      "id": "ads",
      "name": "广告与跟踪拦截",
      "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs",
      "autoUpdate": true,
      "updateHours": 24
    },
    {
      "id": "openai",
      "name": "OpenAI / ChatGPT",
      "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/openai.srs",
      "autoUpdate": true,
      "updateHours": 24
    },
    {
      "id": "anthropic",
      "name": "Claude / Anthropic",
      "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/anthropic.srs",
      "autoUpdate": true,
      "updateHours": 24
    },
    {
      "id": "apple-cn",
      "name": "Apple 国内直连",
      "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple-cn.srs",
      "autoUpdate": true,
      "updateHours": 24
    },
    {
      "id": "steam-cn",
      "name": "Steam 国内直连",
      "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/steam@cn.srs",
      "autoUpdate": true,
      "updateHours": 24
    }
  ],
  "appGroups": [
    {
      "id": "ag-ai-dev",
      "name": "AI 与开发工具",
      "apps": ["Cursor.exe", "Code.exe", "Antigravity.exe", "git.exe", "gh.exe"]
    },
    {
      "id": "ag-cn-office",
      "name": "国内办公与通讯",
      "apps": ["WeChat.exe", "Weixin.exe", "QQ.exe", "DingTalk.exe", "Feishu.exe", "WXWork.exe", "wps.exe"]
    },
    {
      "id": "ag-games",
      "name": "游戏平台",
      "apps": ["steam.exe", "steamwebhelper.exe", "EpicGamesLauncher.exe"]
    }
  ],
  "rules": [
    {
      "id": "preset-ads-block",
      "name": "广告与跟踪拦截",
      "enabled": true,
      "apps": [],
      "hosts": ["ruleset:ads"],
      "ports": [],
      "network": "any",
      "action": "block",
      "resolveBefore": false
    },
    {
      "id": "preset-intranet-direct",
      "name": "公司内网 / 本地域名直连",
      "enabled": true,
      "apps": [],
      "hosts": ["*.corp", "*.local", "*.lan", "*.internal", "*.home.arpa"],
      "ports": [],
      "network": "any",
      "action": "direct",
      "resolveBefore": false
    },
    {
      "id": "preset-ai-apps",
      "name": "AI 与开发工具代理",
      "enabled": true,
      "apps": ["@group:ag-ai-dev"],
      "hosts": [],
      "ports": [],
      "network": "any",
      "action": "proxy",
      "targetId": "proxy",
      "resolveBefore": false
    },
    {
      "id": "preset-ai-domains",
      "name": "AI 服务分流 (OpenAI / Claude)",
      "enabled": true,
      "apps": [],
      "hosts": ["ruleset:openai", "ruleset:anthropic"],
      "ports": [],
      "network": "any",
      "action": "proxy",
      "targetId": "proxy",
      "resolveBefore": false
    },
    {
      "id": "preset-cn-office",
      "name": "国内办公与通讯直连",
      "enabled": true,
      "apps": ["@group:ag-cn-office"],
      "hosts": [],
      "ports": [],
      "network": "any",
      "action": "direct",
      "resolveBefore": false
    },
    {
      "id": "preset-apple-steam-cn",
      "name": "Apple / Steam 国内直连",
      "enabled": true,
      "apps": [],
      "hosts": ["ruleset:apple-cn", "ruleset:steam-cn"],
      "ports": [],
      "network": "any",
      "action": "direct",
      "resolveBefore": false
    },
    {
      "id": "preset-cn-domains",
      "name": "中国大陆域名直连",
      "enabled": true,
      "apps": [],
      "hosts": ["geosite:cn"],
      "ports": [],
      "network": "any",
      "action": "direct",
      "resolveBefore": false
    },
    {
      "id": "preset-non-cn-domains",
      "name": "海外域名代理",
      "enabled": true,
      "apps": [],
      "hosts": ["geosite:geolocation-!cn"],
      "ports": [],
      "network": "any",
      "action": "proxy",
      "targetId": "proxy",
      "resolveBefore": false
    },
    {
      "id": "preset-cn-ip",
      "name": "中国大陆 IP 直连",
      "enabled": true,
      "apps": [],
      "hosts": ["geoip:cn"],
      "ports": [],
      "network": "any",
      "action": "direct",
      "resolveBefore": true
    }
  ],
  "dns": {
    "mode": "fakeip",
    "remote": "https://1.1.1.1/dns-query",
    "direct": "https://223.5.5.5/dns-query",
    "strategy": "prefer_ipv4",
    "servers": [
      {
        "id": "corp-intranet",
        "name": "公司内网 DNS（按需修改为实际内网 IP）",
        "address": "udp://10.0.0.53",
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "id": "dns-preset-intranet",
        "name": "内网域名定向解析",
        "enabled": true,
        "domains": ["*.corp", "*.local", "*.lan", "*.internal", "*.home.arpa"],
        "server": "corp-intranet"
      },
      {
        "id": "dns-preset-cn",
        "name": "国内域名走直连 DoH",
        "enabled": true,
        "domains": ["geosite:cn", "ruleset:apple-cn", "ruleset:steam-cn"],
        "server": "direct"
      }
    ]
  }
}
